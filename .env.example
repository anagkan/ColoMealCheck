# Copy to .env and edit before the first `docker compose up`.

# Postgres
POSTGRES_USER=colonial
POSTGRES_PASSWORD=change-me
POSTGRES_DB=colomealcheck

# Signs admin session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Port the kiosk laptop connects to: http://<server-host>:8000
API_PORT=8000

TIMEZONE=America/New_York

# Created on first boot if no staff users exist yet. Leave the password blank
# and one is generated and printed to the api container logs.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Typed at the kiosk to authorize enrollment, guest overrides, and forced entries.
STAFF_PIN=1234
