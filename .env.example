# Copy to .env and edit before the first `docker compose up`.

# Postgres
POSTGRES_USER=colonial
POSTGRES_PASSWORD=change-me
POSTGRES_DB=colomealcheck

# Signs admin session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Port the kiosk laptop connects to: http://<server-host>:8000
API_PORT=8000

TIMEZONE=America/New_York

# The admin login for /admin.
#
# Set a password here and it is applied on every boot: change it, then
# `docker compose up -d`, and the new one works immediately. This is currently
# the only way to change an admin password — there is no screen for it in the
# app. Changing ADMIN_USERNAME renames the account rather than adding a second.
#
# Leave the password blank and the first boot generates one and prints it to
# `docker compose logs api`, once; after that the account is left alone.
#
# Anyone who can read this file can sign in as an admin. Keep it off the kiosk
# laptop and out of git (.gitignore already excludes it).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Typed at the kiosk to authorize enrollment, guest overrides, and forced entries.
STAFF_PIN=1234
